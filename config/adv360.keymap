#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        macro_ltu: macro_ltu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &kp T &kp U>;
            label = "MACRO_LTU";
        };

        macro_nn: macro_nn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N &kp N>;
            label = "MACRO_NN";
        };

        macro_ime_on: macro_ime_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F18 &to 4>;
            label = "MACRO_IME_ON";
        };

        macro_ime_off: macro_ime_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F17 &to 0>;
            label = "MACRO_IME_OFF";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC           &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                                      &mo 3          &kp N6  &kp N7  &kp N8     &kp N9      &kp N0         &kp MINUS
&kp TAB           &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                                       &to 4          &kp Y   &kp U   &kp I      &kp O       &kp P          &kp APOS
&kp LEFT_CONTROL  &kp A      &kp S     &kp D     &kp F      &kp G   &kp F17  &kp EQUAL  &kp LALT           &kp LGUI       &kp NON_US_BACKSLASH  &macro_ime_on  &kp H   &kp J   &kp K      &kp L       &kp SEMICOLON  &kp RIGHT_CONTROL
&kp LSHFT         &kp Z      &kp X     &kp C     &kp V      &kp B                       &kp DELETE         &kp DELETE                                          &kp N   &kp M   &kp COMMA  &kp PERIOD  &kp SLASH      &kp RSHFT
&mo 2             &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &mo 1    &kp SPACE  &kp BACKSPACE      &kp BACKSPACE  &kp ENTER             &mo 1                  &kp UP  &kp DOWN   &kp LBKT    &kp RBKT       &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp ESCAPE        &none      &none           &none              &none            &none          &trans                                                     &mo 3   &none              &none              &none            &none            &none         &none
&kp TAB           &none      &kp PAGE_UP     &kp UP             &kp PAGE_DOWN    &none          &none                                                      &none   &none              &kp PAGE_UP        &kp UP_ARROW     &kp PAGE_DOWN    &kp KP_MINUS  &none
&kp LEFT_CONTROL  &kp HOME   &kp LEFT_ARROW  &kp DOWN_ARROW     &kp RIGHT_ARROW  &kp END        &none   &none    &kp LALT           &kp LGUI    &none      &none   &kp HOME           &kp LEFT_ARROW     &kp DOWN_ARROW   &kp RIGHT_ARROW  &kp END       &kp RIGHT_CONTROL
&kp LSHFT         &kp LC(Z)  &kp LC(X)       &kp LC(C)          &kp LC(V)        &kp LA(SPACE)                   &none              &none                          &kp K_APPLICATION  &kp LC(KP_PLUS)    &kp F17          &kp F18          &none         &kp RSHFT
&mo 2             &none      &none           &kp C_VOLUME_DOWN  &kp C_VOLUME_UP                 &trans  &kp DEL  &kp BACKSPACE      &kp DELETE  &kp ENTER  &trans                     &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp F22          &kp F23       &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F18  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans   &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        Japanese {
            display-name = "Red";
            bindings = <
&kp ESC           &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                                             &mo 3    &kp N6     &kp N7      &kp N8     &kp N9      &kp N0     &kp MINUS
&kp TAB           &kp P      &kp R     &kp N     &kp M      &kp F   &to 0                                                                              &none    &none      &macro_ltu  &kp I      &kp E       &kp L      &kp APOS
&kp LEFT_CONTROL  &kp H      &kp T     &kp S     &kp K      &kp W   &macro_ime_off  &kp EQUAL  &kp LALT           &kp LGUI       &kp NON_US_BACKSLASH  &kp F18  &kp MINUS  &kp A       &kp U      &kp O       &kp Y      &kp RIGHT_CONTROL
&kp LSHFT         &kp B      &kp D     &kp Z     &kp G      &kp V                              &kp DELETE         &kp DELETE                                    &none      &macro_nn   &kp COMMA  &kp PERIOD  &kp SLASH  &kp RSHFT
&mo 6             &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &mo 1           &kp SPACE  &kp BACKSPACE      &kp BACKSPACE  &kp ENTER             &mo 1               &kp UP      &kp DOWN   &kp LBKT    &kp RBKT   &mo 6
            >;
        };

        keypad_JP {
            display-name = "Purple";
            bindings = <
&kp ESCAPE        &none      &none           &none              &none            &none          &trans                                                     &mo 3   &none              &none              &none            &none            &none         &none
&kp TAB           &none      &kp PAGE_UP     &kp UP             &kp PAGE_DOWN    &none          &none                                                      &none   &none              &kp PAGE_UP        &kp UP_ARROW     &kp PAGE_DOWN    &kp KP_MINUS  &none
&kp LEFT_CONTROL  &kp HOME   &kp LEFT_ARROW  &kp DOWN_ARROW     &kp RIGHT_ARROW  &kp END        &none   &none    &kp LALT           &kp LGUI    &none      &none   &kp HOME           &kp LEFT_ARROW     &kp DOWN_ARROW   &kp RIGHT_ARROW  &kp END       &kp RIGHT_CONTROL
&kp LSHFT         &kp LC(Z)  &kp LC(X)       &kp LC(C)          &kp LC(V)        &kp LA(SPACE)                   &none              &none                          &kp K_APPLICATION  &kp LC(KP_PLUS)    &kp F17          &kp F18          &none         &kp RSHFT
&mo 2             &none      &none           &kp C_VOLUME_DOWN  &kp C_VOLUME_UP                 &trans  &kp DEL  &kp BACKSPACE      &kp DELETE  &kp ENTER  &trans                     &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp F22          &kp F23       &mo 2
            >;
        };

        Fn_JP {
            display-name = "Cyan";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F18  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans   &trans   &trans   &trans
            >;
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
